<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RedisExcel.LivenessTests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dependencies of the linked production sources below. -->
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0-beta2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.0-rc3" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.41" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!--
    Same production source set as test\RedisExcel.Tests: linked Compile items
    instead of a ProjectReference so the add-in/ExcelDna packing never runs for
    this host-side liveness suite. RedisRtd.cs is intentionally NOT linked (the
    RTD/COM surface needs Excel). Any NEW root production file needed here must
    be added to this Compile list and to the unit project's list.
  -->
  <ItemGroup>
    <Compile Include="..\..\Config.cs" Link="Production\Config.cs" />
    <Compile Include="..\..\Conflation.cs" Link="Production\Conflation.cs" />
    <Compile Include="..\..\ExcelJson.cs" Link="Production\ExcelJson.cs" />
    <Compile Include="..\..\RedisConnectionManager.cs" Link="Production\RedisConnectionManager.cs" />
    <Compile Include="..\..\RedisResultFormatter.cs" Link="Production\RedisResultFormatter.cs" />
    <Compile Include="..\..\RedisSubscriptionManager.cs" Link="Production\RedisSubscriptionManager.cs" />
    <Compile Include="..\..\RedisRuntime.cs" Link="Production\RedisRuntime.cs" />
    <Compile Include="..\..\TickGate.cs" Link="Production\TickGate.cs" />
    <Compile Include="..\..\UpdateCheck.cs" Link="Production\UpdateCheck.cs" />
    <Compile Include="..\..\RedisUDF.cs" Link="Production\RedisUDF.cs" />
    <Compile Include="..\..\RedisUdfAsync.cs" Link="Production\RedisUdfAsync.cs" />
    <Compile Include="..\TestSupport\ObserverDoubles.cs" Link="TestSupport\ObserverDoubles.cs" />
  </ItemGroup>

</Project>
