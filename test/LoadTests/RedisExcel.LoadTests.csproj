<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RedisExcel.LoadTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.0.0-rc3" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.41" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NJsonSchema" Version="10.9.0" />
    <!-- Config.cs resolves the add-in folder via ExcelDnaUtil.XllPath. -->
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0-beta2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- Compiles the production sources directly (ONE shared list). -->
  <Import Project="..\TestSupport\ProductionSources.props" />

  <ItemGroup>
    <Compile Include="..\TestSupport\AntivirusInfo.cs" Link="TestSupport\AntivirusInfo.cs" />
  </ItemGroup>

</Project>