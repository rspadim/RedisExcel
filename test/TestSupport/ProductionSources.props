<Project>

  <!--
    Shared production-source list for every RedisExcel test project.

    The unit, smoke, load and liveness suites compile the production sources
    directly (linked Compile items) instead of using a ProjectReference to
    RedisExcel.csproj: a ProjectReference would run the Excel-DNA packing step on
    every test run. Putting the item group here ONCE replaces the four
    hand-maintained lists a new production file had to be added to four times -
    the drift that let test\LoadTests compile without the ExcelDna reference
    (audit round K).

    RedisRtd.cs is the ONLY intentional exclusion: it is the Excel/COM surface
    (RTD server, [ExcelFunction] status helpers) and is exercised by the Excel
    end-to-end suite and the shipped-assembly public-surface test instead.
    Everything else at the repository root is linked.

    Any NEW top-level production *.cs file must be added below;
    test\RedisExcel.Tests\ProjectFileParityTests.cs enforces that every existing
    root source is listed here, so a file can never be silently missing.

    Paths are relative to THIS file (test\TestSupport\), so every importing
    project gets the same list: $(MSBuildThisFileDirectory)..\..\ is the repo root.
  -->

  <ItemGroup Label="ProductionSources">
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Config.cs" Link="Production\Config.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\ConfigSchema.cs" Link="Production\ConfigSchema.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Conflation.cs" Link="Production\Conflation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\ExcelJson.cs" Link="Production\ExcelJson.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\RedisConnectionManager.cs" Link="Production\RedisConnectionManager.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\RedisResultFormatter.cs" Link="Production\RedisResultFormatter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\RedisRuntime.cs" Link="Production\RedisRuntime.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\RedisSubscriptionManager.cs" Link="Production\RedisSubscriptionManager.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\RedisUDF.cs" Link="Production\RedisUDF.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\RedisUdfAsync.cs" Link="Production\RedisUdfAsync.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\TickGate.cs" Link="Production\TickGate.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\UpdateCheck.cs" Link="Production\UpdateCheck.cs" />
  </ItemGroup>

  <!--
    The configuration schema is an embedded resource of the add-in so the
    tolerance/schema walk can read it without touching disk. The linked
    ConfigSchema.cs expects a resource whose name ends with
    "RedisExcel.schema.json"; embedding it here gives every test assembly the
    same resource.
  -->
  <ItemGroup Label="ProductionResources">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\RedisExcel.schema.json">
      <LogicalName>RedisExcel.schema.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
